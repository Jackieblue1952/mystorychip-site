{
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/stripe-webhook.js"
    },
    {
      "source": "/api/admin-login",
      "destination": "/api/admin-login.js"
    },
    {
      "source": "/api/admin-chips",
      "destination": "/api/admin-chips.js"
    },
    {
      "source": "/api/chip-data",
      "destination": "/api/chip-data.js"
    }
  ]
}
